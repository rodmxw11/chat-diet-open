# Optional: serve HTTPS directly on 443 using a Tailscale-issued cert, so the app is
# reachable from other tailnet devices (e.g. a phone) at https://<machine>.<tailnet>.ts.net
# with no reverse proxy. Requires "HTTPS Certificates" enabled in the Tailscale admin
# console (DNS tab), then run from backend/:
#   tailscale cert --cert-file certs/<machine>.<tailnet>.ts.net.crt \
#                   --key-file certs/<machine>.<tailnet>.ts.net.key \
#                   <machine>.<tailnet>.ts.net
# certs/ is gitignored - regenerate locally, never commit the private key.
# Omit this whole `server:` block to fall back to plain HTTP on the default port (8080).
server:
  port: 443
  ssl:
    certificate: file:certs/<machine>.<tailnet>.ts.net.crt
    certificate-private-key: file:certs/<machine>.<tailnet>.ts.net.key

spring:
  application:
    name: backend

  datasource:
    url: jdbc:sqlite:./data/chat-diet.db
    driver-class-name: org.sqlite.JDBC

  liquibase:
    change-log: classpath:db/changelog/db.changelog-master.yaml

  ai:
    anthropic:
      # Your Anthropic API key. This file is gitignored once copied to application.yml,
      # so it's safe to put the literal key here directly.
      api-key: your-anthropic-api-key-here
      chat:
        model: claude-haiku-4-5-20251001
        max-tokens: 1024

chat-diet:
  day-rollover-hour: 4

  chat:
    # How many of the current day's messages are replayed to the model each turn. The DB is the
    # real memory - the model recalls earlier facts through its data-reading tools, not from a
    # long transcript - so this is a cost/latency control and stays small. It does not affect
    # what the UI displays: GET /api/chat/history always returns the whole day.
    context-messages: 10

  # Where the daily backup job (and the on-demand /api/export endpoint) write/read archives.
  backup-dir: ./data/backups

  # Used only to draw the weight-trend goal line and by the (separate, TDEE-independent)
  # weight-projection tool. Negative to lose weight, positive to gain, 0 for maintenance.
  # The actual calorie target is set manually via the set_calorie_goal chat tool, not derived
  # from this.
  goal:
    weekly-rate-lbs: -1.0

  # Free api.data.gov key for USDA FoodData Central (raw/generic-food lookups, e.g. "42g of
  # celery"). Get one at https://api.data.gov/signup/ - no cost, no expiry. If left blank, that
  # lookup tier is silently skipped and food logging falls through to a model estimate instead.
  fdc:
    api-key: ""
